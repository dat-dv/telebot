# Public URL used by the API, bot, OAuth callback, and dashboard entry links.
# Avoid the SERVICE_URL_* prefix: Coolify reserves it for managed URL variables.
APP_URL=https://telebot.datintech.site
# Optional when the Dashboard is served from a different public origin.
WEB_ORIGIN=https://telebot.datintech.site
# Temporary cross-origin access for local frontend testing. Keep false in production.
CORS_ALLOW_ALL=false
# Port exposed by the NestJS API.
PORT=3000
# PostgreSQL is the production system of record. Keep TYPEORM_SYNCHRONIZE=false.
POSTGRES_DB=telebot
POSTGRES_USER=telebot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://telebot:replace-with-a-long-random-password@localhost:5432/telebot
DATABASE_SSL=false
# Keep false in normal operation. Set true for exactly one empty-database bootstrap deploy.
TYPEORM_SYNCHRONIZE=false
# Redis stores short-lived confirmation, transcript, conversation, and rate-limit state.
REDIS_URL=redis://localhost:6379
# Public API URL baked into the static Dashboard build.
NEXT_PUBLIC_API_URL=https://telebot.datintech.site
# Optional public Telegram bot URL or username for dashboard session screen
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/datdoan_assistant_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=datdoan_assistant_bot

# Required server secrets
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ADMIN_ID=replace-me
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_LONG_POLLING_ENABLED=true
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash-lite
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-a-64-character-random-secret
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-a-different-64-character-random-secret

# Local AI and document-processing services
WHISPER_URL=http://127.0.0.1:8080
WHISPER_TIMEOUT_MS=45000
VOICE_MAX_DURATION_SECONDS=90
VOICE_MAX_BYTES=8388608
RECEIPT_IMAGE_TIMEOUT_MS=45000
RECEIPT_IMAGE_MAX_BYTES=10485760
TESSERACT_LANG_PATH=/app/assets/tessdata
RECEIPT_STORAGE_DIR=/app/data/receipts
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# CallMe (required only when the flash-call feature is enabled)
TELEGRAM_API_ID=replace-me
TELEGRAM_API_HASH=replace-me
TELEGRAM_SESSION=replace-me
