# ============================================================
# CẤU HÌNH BẮT BUỘC
# ============================================================

# 1. Token Bot từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Telegram User ID của Admin (lấy từ @userinfobot)
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# 3. Gemini API Key từ Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Google OAuth Credentials (từ Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 5. Public Application URL (hoặc Domain Coolify)
APP_URL=https://your-bot-domain.com

# 6. GramJS (MTProto Telegram Client) cho tính năng CallMe (Gọi Nhá Máy - Tùy chọn)
# TELEGRAM_API_ID=your_api_id_from_my_telegram_org
# TELEGRAM_API_HASH=your_api_hash_from_my_telegram_org
# TELEGRAM_SESSION=your_generated_session_token_from_npm_run_gramjs_login

# ============================================================
# CẤU HÌNH TÙY CHỌN (ĐÃ CÓ MẶC ĐỊNH SẴN TRONG CODE)
# ============================================================
PORT=3000
GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Mã mở trang báo cáo tài chính trên server (bắt buộc để truy cập /reports)
REPORT_ACCESS_TOKEN=replace_with_a_long_random_secret
DATA_ENCRYPTION_KEY=replace_with_a_different_64_character_hex_secret
