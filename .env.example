# Public URL used by the API, bot, OAuth callback, and dashboard entry links.
# Avoid the SERVICE_URL_* prefix: Coolify reserves it for managed URL variables.
APP_URL=https://telebot.datintech.site
# Optional when the Dashboard is served from a different public origin.
WEB_ORIGIN=https://telebot.datintech.site
# Temporary cross-origin access for local frontend testing. Keep false in production.
CORS_ALLOW_ALL=false
# Public API URL baked into the static Dashboard build.
NEXT_PUBLIC_API_URL=https://telebot.datintech.site

# Required server secrets
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ADMIN_ID=replace-me
GEMINI_API_KEY=replace-me
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-a-64-character-random-secret
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-a-different-64-character-random-secret

# CallMe (required only when the flash-call feature is enabled)
TELEGRAM_API_ID=replace-me
TELEGRAM_API_HASH=replace-me
TELEGRAM_SESSION=replace-me
