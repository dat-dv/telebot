# API (server only)
PORT=3000
# Public API URL, used for OAuth callbacks.
SERVICE_URL_TELEBOT=https://api.telebot.example.com
# Public static dashboard origin; API redirects authenticated users here and allows CORS from it.
WEB_ORIGIN=https://telebot.example.com
# Baked into the static web output at build time; safe to expose because it is an API URL.
NEXT_PUBLIC_API_URL=https://api.telebot.example.com
WEB_PORT=3001
TELEGRAM_BOT_TOKEN=replace-me
# Chỉ một instance dùng cùng bot token được đặt true; API local chỉ phục vụ dashboard đặt false.
TELEGRAM_LONG_POLLING_ENABLED=true
TELEGRAM_ADMIN_ID=replace-me
GEMINI_API_KEY=replace-me
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
DASHBOARD_ACCESS_TOKEN_SECRET=replace-with-a-different-64-character-random-secret
DASHBOARD_REFRESH_TOKEN_SECRET=replace-with-a-different-64-character-random-secret
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Voice-to-text local runtime (không cần API key)
WHISPER_URL=http://127.0.0.1:8080
WHISPER_TIMEOUT_MS=45000
VOICE_MAX_DURATION_SECONDS=90
VOICE_MAX_BYTES=8388608

# Web config belongs in apps/web/.env.local (safe to expose in the Next.js static client bundle)
# NEXT_PUBLIC_API_URL=http://localhost:3000
